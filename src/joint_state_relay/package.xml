<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>joint_state_relay</name>
  <version>0.1.0</version>
  <description>Joint state relay between leader and follower robotic arms</description>
  <maintainer email="jialiang@todo.todo">jialiang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>stararm102_description</exec_depend>
  <exec_depend>rebotarm_hw_driver</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
