<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rebotarm_hw_driver</name>
  <version>0.1.0</version>
  <description>reBotArm B601 hardware driver with ROS2 command interface</description>
  <maintainer email="jialiang@todo.todo">jialiang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rebotarm_gazebo</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
