<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rebotarm_arm">
  <xacro:arg name="gains_file" default="$(find microros_stm32h723_bridge)/config/arm_mit_gains.yaml"/>
  <xacro:arg name="enable_gripper" default="false"/>

  <xacro:include filename="$(find rebotarm_gazebo)/urdf/rebotarm.urdf"/>

  <ros2_control name="Stm32H723ArmSystem" type="system">
    <hardware>
      <plugin>microros_stm32h723_bridge/MicroRosSystem</plugin>
      <param name="command_topic">/stm32/joint_commands</param>
      <param name="state_topic">/stm32/joint_states</param>
      <param name="status_topic">/stm32/status</param>
      <param name="state_timeout_ms">500</param>
      <param name="activation_timeout_ms">5000</param>
      <param name="return_duration_ms">3000</param>
      <param name="zero_tolerance">0.03</param>
      <xacro:if value="$(arg enable_gripper)">
        <param name="required_joint_mask">0x7F</param>
      </xacro:if>
      <xacro:unless value="$(arg enable_gripper)">
        <param name="required_joint_mask">0x3F</param>
      </xacro:unless>
      <param name="gains_file">$(arg gains_file)</param>
      <param name="gripper_position_scale">-0.008612826752</param>
      <param name="gripper_position_offset">0.004282757541</param>
    </hardware>

    <joint name="joint1">
      <command_interface name="position">
        <param name="min">-2.8</param>
        <param name="max">2.8</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <command_interface name="effort"/>
      <command_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <command_interface name="effort"/>
      <command_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <command_interface name="effort"/>
      <command_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position">
        <param name="min">-1.87</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <command_interface name="effort"/>
      <command_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <command_interface name="effort"/>
      <command_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <command_interface name="effort"/>
      <command_interface name="velocity"/>
    </joint>
    <xacro:if value="$(arg enable_gripper)">
      <joint name="gripper_finger_left_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.05</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <command_interface name="effort"/>
      </joint>
    </xacro:if>
  </ros2_control>
</robot>
