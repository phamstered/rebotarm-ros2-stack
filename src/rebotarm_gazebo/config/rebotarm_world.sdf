    <model name="rebotarm">
      <static>false</static>
      <self_collide>false</self_collide>
      <link name="base_link">
        <inertial><mass>0.837</mass><inertia><ixx>0.00276</ixx><iyy>0.00213</iyy><izz>0.00133</izz></inertia></inertial>
        <visual name="v"><geometry><mesh><uri>model://rebotarm_gazebo/meshes/base_link.STL</uri></mesh></geometry></visual>
        <collision name="c"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
      </link>
      <link name="link1">
