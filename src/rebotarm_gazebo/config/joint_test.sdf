<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <physics type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="two_link">
      <static>false</static>
      <link name="base">
        <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.1 0.1 0.2</size></box></geometry></visual>
        <collision name="c"><geometry><box><size>0.1 0.1 0.2</size></box></geometry></collision>
      </link>
      <link name="link1">
        <inertial><mass>0.5</mass><inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.005</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.05 0.05 0.3</size></box></geometry></visual>
      </link>
      <joint name="joint1" type="revolute">
        <parent>base</parent><child>link1</child>
        <pose>0 0 0.1 0 0 0</pose>
        <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper></limit></axis>
      </joint>
    </model>
  </world>
</sdf>
